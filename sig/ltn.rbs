module LTN
  VERSION: String

  class Error < StandardError
  end

  # The device on which LTN places the groundings of its variables.
  def self.device: () -> untyped
  def self.device=: (untyped device) -> untyped

  # A grounding together with the labels of its free variables.
  class LTNObject
    attr_accessor value: untyped
    attr_accessor free_vars: Array[String]

    def initialize: (untyped value, Array[String] var_labels) -> void
    def shape: () -> Array[Integer]
  end

  module FuzzyOps
    EPS: Float

    def self.pi_0: (untyped x) -> untyped
    def self.pi_1: (untyped x) -> untyped
    def self.check_values: (*untyped values) -> void
    def self.check_mask: (untyped mask, untyped xs) -> void
    def self.reduction_dims: (Integer | Array[Integer] | nil dim) -> Array[Integer]
    def self.where: (untyped condition, untyped input, untyped other) -> untyped

    module Stable
      attr_accessor stable: bool
      def initialize: (?stable: bool) -> void
    end

    class ConnectiveOperator
      def call: (*untyped args, **untyped kwargs) -> untyped
    end

    class UnaryConnectiveOperator < ConnectiveOperator
    end

    class BinaryConnectiveOperator < ConnectiveOperator
    end

    class NotStandard < UnaryConnectiveOperator
      def call: (untyped x) -> untyped
    end

    class NotGodel < UnaryConnectiveOperator
      def call: (untyped x) -> untyped
    end

    class AndMin < BinaryConnectiveOperator
      def call: (untyped x, untyped y) -> untyped
    end

    class AndProd < BinaryConnectiveOperator
      include Stable
      def call: (untyped x, untyped y, ?stable: bool?) -> untyped
    end

    class AndLuk < BinaryConnectiveOperator
      def call: (untyped x, untyped y) -> untyped
    end

    class OrMax < BinaryConnectiveOperator
      def call: (untyped x, untyped y) -> untyped
    end

    class OrProbSum < BinaryConnectiveOperator
      include Stable
      def call: (untyped x, untyped y, ?stable: bool?) -> untyped
    end

    class OrLuk < BinaryConnectiveOperator
      def call: (untyped x, untyped y) -> untyped
    end

    class ImpliesKleeneDienes < BinaryConnectiveOperator
      def call: (untyped x, untyped y) -> untyped
    end

    class ImpliesGodel < BinaryConnectiveOperator
      def call: (untyped x, untyped y) -> untyped
    end

    class ImpliesReichenbach < BinaryConnectiveOperator
      include Stable
      def call: (untyped x, untyped y, ?stable: bool?) -> untyped
    end

    class ImpliesGoguen < BinaryConnectiveOperator
      include Stable
      def call: (untyped x, untyped y, ?stable: bool?) -> untyped
    end

    class ImpliesLuk < BinaryConnectiveOperator
      def call: (untyped x, untyped y) -> untyped
    end

    class Equiv < BinaryConnectiveOperator
      attr_reader and_op: BinaryConnectiveOperator
      attr_reader implies_op: BinaryConnectiveOperator

      def initialize: (BinaryConnectiveOperator and_op, BinaryConnectiveOperator implies_op) -> void
      def call: (untyped x, untyped y) -> untyped
    end

    type dim = Integer | Array[Integer] | nil

    class AggregationOperator
      def call: (*untyped args, **untyped kwargs) -> untyped
    end

    module PMeanParameters
      attr_accessor p: Numeric
      attr_accessor stable: bool
      def initialize: (?p: Numeric, ?stable: bool) -> void
    end

    class AggregMin < AggregationOperator
      def call: (untyped xs, ?dim: dim, ?keepdim: bool, ?mask: untyped) -> untyped
    end

    class AggregMean < AggregationOperator
      def call: (untyped xs, ?dim: dim, ?keepdim: bool, ?mask: untyped) -> untyped
    end

    class AggregPMean < AggregationOperator
      include PMeanParameters
      def call: (untyped xs, ?dim: dim, ?keepdim: bool, ?mask: untyped, ?p: Numeric?, ?stable: bool?) -> untyped
    end

    class AggregPMeanError < AggregationOperator
      include PMeanParameters
      def call: (untyped xs, ?dim: dim, ?keepdim: bool, ?mask: untyped, ?p: Numeric?, ?stable: bool?) -> untyped
    end

    class SatAgg
      attr_reader agg_op: AggregationOperator

      def initialize: (?AggregationOperator agg_op) -> void
      def call: (*untyped closed_formulas) -> untyped
    end
  end

  class Constant < LTNObject
    def initialize: (untyped value, ?trainable: bool) -> void
  end

  class Variable < LTNObject
    attr_reader latent_var: String

    def initialize: (String var_label, untyped individuals, ?add_batch_dim: bool) -> void
  end

  def self.process_ltn_objects: (Array[LTNObject] objects) -> [Array[LTNObject], Array[String], Array[Integer]]
  def self.diag: (*Variable vars) -> Array[Variable]
  def self.undiag: (*Variable vars) -> Array[Variable]

  class LambdaModel
    attr_reader func: untyped

    def initialize: (untyped func) -> void
    def forward: (*untyped inputs, **untyped kwargs) -> untyped
  end

  module ModelWrapper
    attr_reader model: untyped

    def initialize: (?untyped model, ?func: untyped) ?{ (*untyped) -> untyped } -> void
  end

  class Predicate
    include ModelWrapper

    def forward: (*LTNObject inputs, **untyped kwargs) -> LTNObject
    def call: (*LTNObject inputs, **untyped kwargs) -> LTNObject
  end

  class Function
    include ModelWrapper

    def forward: (*LTNObject inputs, **untyped kwargs) -> LTNObject
    def call: (*LTNObject inputs, **untyped kwargs) -> LTNObject
  end

  class Connective
    attr_reader connective_op: FuzzyOps::ConnectiveOperator

    def initialize: (FuzzyOps::ConnectiveOperator connective_op) -> void
    def call: (*LTNObject operands, **untyped kwargs) -> LTNObject
  end

  class Quantifier
    QUANTIFIERS: Hash[Symbol | String, Symbol]

    attr_reader agg_op: FuzzyOps::AggregationOperator
    attr_reader quantifier: Symbol

    def initialize: (FuzzyOps::AggregationOperator agg_op, Symbol | String quantifier) -> void
    def call: (Variable | Array[Variable] vars, LTNObject formula, ?cond_vars: (Variable | Array[Variable])?,
               ?cond_fn: untyped, **untyped kwargs) ?{ (*LTNObject) -> untyped } -> LTNObject
    def self.compute_mask: (LTNObject formula, Array[Variable] cond_vars, untyped cond_fn, Array[String] aggregation_vars) -> [LTNObject, LTNObject]
    def self.transpose_vars: (LTNObject object, Array[String] new_vars_order) -> LTNObject
  end
end
